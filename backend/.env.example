# ─── Hostinger & Production Environment Config ──────────────────────────────────────────

# ─── Database Options (Use Option A or Option B) ──────────────────────────────────────
# Option A: Neon PostgreSQL (Recommended for Serverless PG)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# Option B: Standard / Managed PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=link_shortener
# DATABASE_SSL=false

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens (Must be at least 32 random characters in production)
JWT_SECRET=your-production-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1d

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Deployed Vercel frontend origin (e.g., https://your-app.vercel.app or comma-separated list)
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Server Configuration ──────────────────────────────────────────────────────
# Hostinger assigns dynamic PORT automatically if left empty, or set to 3000
PORT=3000
NODE_ENV=production

