# ─── Hostinger & Production Environment Config ──────────────────────────────────────────

# ─── Database: Option A (Neon PostgreSQL) ────────────────────────────────────────────
# Neon Cloud PostgreSQL Connection URL (Includes sslmode=require)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens (Must be at least 32 random characters in production)
JWT_SECRET=your-production-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1d

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Deployed Vercel frontend origin (e.g., https://your-app.vercel.app or comma-separated list)
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Server Configuration ──────────────────────────────────────────────────────
# Hostinger assigns dynamic PORT automatically if left empty, or set to 3000
PORT=3000
NODE_ENV=production
