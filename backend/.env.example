# ─── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL: host=localhost, port=5433, ssl=false
# Neon PostgreSQL:  host=ep-xxx.neon.tech, port=5432, ssl=true
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=link_shortener
DATABASE_SSL=false

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens (Must be at least 32 random characters in production)
JWT_SECRET=your-production-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=1d

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Deployed frontend origin (e.g., https://your-app.vercel.app or comma-separated list)
FRONTEND_URL=http://localhost:3001

# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
